{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DQOR public programme v1 unavailable error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "const": "programme_unavailable"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
