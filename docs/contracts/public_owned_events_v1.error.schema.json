{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://deccanqueenonrails.com/contracts/public_owned_events_v1.error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "event_not_found",
            "events_unavailable"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
