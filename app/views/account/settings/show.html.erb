<% content_for :title, "Settings · Deccan Queen on Rails" %>

<main class="account-page">
  <section class="account-header">
    <%= avatar_image_tag current_user, size: 80, alt: "", class: "account-avatar" %>
    <div class="account-identity">
      <h1>Settings</h1>
      <p class="account-email"><%= current_user.email %></p>
    </div>
  </section>

  <% if flash[:notice] %><p class="notice" role="status"><%= flash[:notice] %></p><% end %>
  <% if current_user.errors.any? %>
    <p class="alert" role="alert"><%= current_user.errors.full_messages.to_sentence %></p>
  <% end %>

  <section class="account-section">
    <h2>Profile</h2>
    <%= form_with model: current_user, url: account_settings_path, method: :patch, scope: :user, class: "assignment-form" do |form| %>
      <div class="field">
        <%= form.label :name, "Display name" %>
        <%= form.text_field :name, autocomplete: "name", placeholder: "How your name appears to others" %>
      </div>
      <div class="field">
        <%= form.label :bio, "About you" %>
        <%= form.text_area :bio, rows: 3, placeholder: "A sentence about what you work on (optional)" %>
      </div>
      <div class="profile-social-fields">
        <div class="field profile-social-fields__website">
          <%= form.label :website, "Website" %>
          <%= form.text_field :website, autocomplete: "url", inputmode: "url", maxlength: 255, placeholder: "your-site.com" %>
        </div>
        <div class="field">
          <%= form.label :x_username, "X (x.com)" %>
          <%= form.text_field :x_username, maxlength: 255, placeholder: "username" %>
        </div>
        <div class="field">
          <%= form.label :bluesky, "Bluesky" %>
          <%= form.text_field :bluesky, maxlength: 255, placeholder: "name.bsky.social" %>
        </div>
        <div class="field">
          <%= form.label :github, "GitHub" %>
          <%= form.text_field :github, maxlength: 255, placeholder: "username" %>
        </div>
        <div class="field">
          <%= form.label :mastodon, "Mastodon" %>
          <%= form.text_field :mastodon, maxlength: 255, placeholder: "name@mastodon.social" %>
        </div>
        <div class="field">
          <%= form.label :linkedin, "LinkedIn" %>
          <%= form.text_field :linkedin, maxlength: 255, placeholder: "profile-name" %>
        </div>
      </div>
      <div class="field">
        <%= form.label :avatar, "Profile photo" %>
        <%= form.file_field :avatar, accept: "image/png,image/jpeg,image/webp" %>
        <p class="gst-hint">Optional — we use your Gravatar if you don’t upload one.</p>
      </div>
      <div class="field">
        <%= form.label :password, "Set a password" %>
        <%= form.password_field :password, autocomplete: "new-password", placeholder: "Optional — you can always sign in by email" %>
      </div>
      <div class="assignment-checkbox">
        <%= form.check_box :discoverable %>
        <%= form.label :discoverable, "List me in the attendee directory so others can connect" %>
      </div>
      <div class="assignment-checkbox">
        <%= form.check_box :public_attendee %>
        <%= form.label :public_attendee, "Show me publicly as attending on the event page" %>
      </div>
      <%= form.submit "Save settings", class: "btn btn-primary" %>
    <% end %>
  </section>

  <% if ENV["VAPID_PUBLIC_KEY"].present? %>
    <section class="account-section" data-controller="notifications">
      <h2>Notifications</h2>
      <p class="notifications-status" data-notifications-target="status">Get a heads-up for schedule changes and conference updates.</p>
      <button type="button" class="btn btn-secondary" data-notifications-target="button" data-action="notifications#toggle" hidden>Enable notifications</button>
    </section>
  <% end %>

  <p class="account-back"><%= link_to "← Back to your account", account_root_path %></p>
</main>
