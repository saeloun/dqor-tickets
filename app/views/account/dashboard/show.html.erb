<% content_for :title, "Your account · Deccan Queen on Rails" %>

<main class="account-page">
  <section class="account-header">
    <%= avatar_image_tag current_user, size: 80, alt: "", class: "account-avatar" %>
    <div class="account-identity">
      <h1><%= current_user.name.presence || "Your account" %></h1>
      <p class="account-email"><%= current_user.email %></p>
    </div>
    <div class="account-actions">
      <%= link_to "Settings", account_settings_path, class: "btn btn-secondary" %>
      <%= button_to "Sign out", account_sign_out_path, method: :delete, class: "btn btn-secondary account-signout" %>
    </div>
  </section>

  <% if Conference.status != :after %>
    <div class="hub-countdown <%= "hub-countdown--live" if Conference.status == :during %>">
      <div class="hub-countdown__lede">
        <% if Conference.status == :during %>
          <span class="hub-countdown__num">Happening now</span>
        <% else %>
          <span class="hub-countdown__num"><%= Conference.days_to_go %></span>
          <span class="hub-countdown__unit"><%= "day".pluralize(Conference.days_to_go) %> to go</span>
        <% end %>
      </div>
      <div class="hub-countdown__meta">
        <strong>Deccan Queen on Rails</strong>
        <span><%= Conference::DATE_RANGE_LABEL %> &middot; <%= Conference::VENUE %></span>
      </div>
    </div>
  <% end %>

  <nav class="hub-actions" aria-label="Conference hub">
    <%= link_to schedule_path, class: "hub-tile" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      <span class="hub-tile__label">Schedule</span>
      <span class="hub-tile__hint">Talks &amp; sessions</span>
    <% end %>
    <%= link_to community_path, class: "hub-tile" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span class="hub-tile__label">Attendees</span>
      <span class="hub-tile__hint">Meet &amp; connect</span>
    <% end %>
    <%= link_to updates_path, class: "hub-tile" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      <span class="hub-tile__label">Updates</span>
      <span class="hub-tile__hint">Latest news</span>
    <% end %>
    <%= link_to "/#venue", class: "hub-tile" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span class="hub-tile__label">Venue &amp; travel</span>
      <span class="hub-tile__hint">Getting there</span>
    <% end %>
    <%= link_to concierge_path, class: "hub-tile" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      <span class="hub-tile__label">Concierge</span>
      <span class="hub-tile__hint">Ask anything</span>
    <% end %>
    <%= link_to account_settings_path, class: "hub-tile" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      <span class="hub-tile__label">Settings</span>
      <span class="hub-tile__hint">Profile &amp; socials</span>
    <% end %>
  </nav>

  <% if @announcements.any? %>
    <section class="account-section">
      <h2>Latest updates</h2>
      <ul class="account-tickets">
        <% @announcements.each do |announcement| %>
          <li class="account-ticket">
            <div class="account-ticket__row">
              <span class="account-ticket__type"><%= announcement.title %></span>
              <span class="account-ticket__meta"><%= announcement.shown_at.strftime("%-d %b") %></span>
            </div>
          </li>
        <% end %>
      </ul>
      <p><%= link_to "All updates", updates_path %>.</p>
    </section>
  <% end %>

  <section class="account-section">
    <h2>Your tickets</h2>
    <% if @tickets.any? %>
      <ul class="account-tickets">
        <% @tickets.each do |ticket| %>
          <li class="account-ticket">
            <div class="account-ticket__row">
              <span class="account-ticket__type"><%= ticket.ticket_type.name %></span>
              <span class="account-ticket__meta"><%= ticket.assigned? ? ticket.attendee_name : "Unassigned" %></span>
              <%= link_to "View order", order_path(ticket.order.code), class: "account-ticket__link" %>
            </div>
            <details class="account-ticket__pass">
              <summary>Show entry pass</summary>
              <%= render "tickets/entry_pass", ticket: ticket %>
            </details>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>No tickets found for <strong><%= current_user.email %></strong> yet. <%= link_to "Browse passes", tickets_store_path %>.</p>
    <% end %>
  </section>

  <% if @saved_talks.any? %>
    <section class="account-section">
      <h2>My schedule</h2>
      <ul class="account-tickets">
        <% @saved_talks.each do |talk| %>
          <li class="account-ticket">
            <div class="account-ticket__row">
              <span class="account-ticket__type"><%= talk.title %></span>
              <span class="account-ticket__meta"><%= talk.time_range %><%= " · #{talk.room}" if talk.room.present? %></span>
            </div>
          </li>
        <% end %>
      </ul>
      <p><%= link_to "Browse the full schedule", schedule_path %>.</p>
    </section>
  <% end %>

  <% profile_url = attendee_url(current_user) %>
  <section class="account-section">
    <h2>Connect with me</h2>
    <div class="connect-card">
      <div class="connect-card__qr" role="img" aria-label="QR code for <%= current_user.display_name %>’s attendee profile">
        <%= connect_qr_svg(profile_url) %>
      </div>
      <div class="connect-card__body">
        <p>Let another attendee scan this code to open your profile and connect with you.</p>
        <p><%= link_to "Scan to connect", account_connection_scan_path, class: "btn btn-primary" %></p>
        <div class="share-link field" data-controller="clipboard">
          <label for="connect-profile-url">Shareable profile link</label>
          <div class="share-link__row">
            <%= text_field_tag :connect_profile_url, profile_url, id: "connect-profile-url", readonly: true, data: { clipboard_target: "source" } %>
            <button type="button" class="share-link__copy" data-action="clipboard#copy" data-clipboard-target="button">Copy</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="account-section">
    <h2>Bring a friend</h2>
    <p>Share your link — friends get <strong>10% off</strong> their pass, and you'll see who joins.</p>
    <div class="share-link field" data-controller="clipboard">
      <label for="referral-link">Your referral link</label>
      <div class="share-link__row">
        <%= text_field_tag :referral_link, tickets_store_url(ref: current_user.referral_code), id: "referral-link", readonly: true, data: { clipboard_target: "source" } %>
        <button type="button" class="share-link__copy" data-action="clipboard#copy" data-clipboard-target="button">Copy</button>
      </div>
    </div>
    <% joined = current_user.referrals_count %>
    <% if joined.positive? %>
      <p class="assignment-summary"><strong><%= pluralize(joined, "friend") %></strong> joined via your link so far. Thank you!</p>
    <% end %>
  </section>

  <section class="account-section">
    <h2>Community</h2>
    <% unless current_user.discoverable? %>
      <p class="gst-hint">You’re not listed in the attendee directory yet. <%= link_to "Turn it on in settings", account_settings_path %> so others can connect with you.</p>
    <% end %>
    <p>You have <%= pluralize(current_user.connections.count, "connection") %>. <%= link_to "Browse attendees", community_path %>.</p>
    <% if (inbound = current_user.connectors.count).positive? %>
      <p><strong><%= pluralize(inbound, "person") %></strong> connected with you.</p>
    <% end %>
    <p>Have a question about the conference? <%= link_to "Ask the concierge", concierge_path %>.</p>
  </section>
</main>
