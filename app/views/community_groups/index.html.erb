<main id="community-main"><p class="eyebrow">Find your people</p><h1>Communities between gatherings.</h1><p>Explore published communities and meet their organizers.</p><div class="community-list"><% @groups.each do |group| %><article><h2><%= link_to group.name, community_group_public_path(group.organization.slug, group.slug) %></h2><p><%= group.tagline %></p><p class="muted"><%= group.city %>, <%= group.country_code %> · <%= group.organization.name %></p></article><% end %></div><% if @groups.empty? %><p>No published communities yet.</p><% end %><% if @page > 1 || @page * 24 < @total %><nav aria-label="Community pages"><% if @page > 1 %><%= link_to "← Previous", communities_path(page: @page - 1) %><% end %><% if @page * 24 < @total %><%= link_to "Next →", communities_path(page: @page + 1) %><% end %></nav><% end %></main>
