<main id="community-main"><%= link_to "← Communities", communities_path %><p class="eyebrow">Hosted by <%= @group.organization.name %></p><h1><%= @group.name %></h1><p class="intro"><%= @group.tagline %></p><p class="muted"><%= @group.city %>, <%= @group.country_code %> · <%= @group.timezone %></p><p class="community-description"><%= @group.description %></p><section aria-labelledby="upcoming-heading"><h2 id="upcoming-heading">Next gatherings</h2><% @upcoming.records.each do |event| %><%= render "event", event: event %><% end %><% if @upcoming.records.empty? %><p>No upcoming gathering has been published yet.</p><% end %><%= render "pages", result: @upcoming, parameter: :upcoming_page %></section><section aria-labelledby="past-heading"><h2 id="past-heading">Past gatherings</h2><% @past.records.each do |event| %><%= render "event", event: event %><% end %><% if @past.records.empty? %><p>No past gatherings published yet.</p><% end %><%= render "pages", result: @past, parameter: :past_page %></section></main>
