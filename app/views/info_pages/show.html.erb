<% content_for :title, "#{@page.title} · Deccan Queen on Rails" %>

<main class="schedule-page">
  <section class="storefront-hero">
    <p class="section-label">Info</p>
    <h1><%= @page.title %></h1>
  </section>

  <% if @page.body.present? %><div class="info-body"><%= simple_format(@page.body) %></div><% end %>

  <p class="account-back"><%= link_to "← All info", info_pages_path %></p>
</main>
