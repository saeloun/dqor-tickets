<% content_for :title, "Reset staff password · Deccan Queen on Rails" %>

<main class="status-page auth-page">
  <section class="status-card">
    <p class="section-label">Conference team</p>
    <h1>Reset your password</h1>
    <p>Enter your staff email address and we’ll email you a password reset link.</p>

    <% if flash[:alert] %><div class="alert" role="alert"><%= flash[:alert] %></div><% end %>

    <%= form_with url: passwords_path, class: "assignment-form auth-form" do |form| %>
      <div class="field">
        <%= form.label :email, "Email address" %>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email] %>
      </div>
      <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
    <% end %>

    <p class="status-hint"><%= link_to "Back to staff sign in", new_session_path %></p>
  </section>
</main>
