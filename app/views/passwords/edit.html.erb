<% content_for :title, "Update staff password · Deccan Queen on Rails" %>

<main class="status-page auth-page">
  <section class="status-card">
    <p class="section-label">Conference team</p>
    <h1>Choose a new password</h1>
    <p>Use at least 8 characters. You’ll sign in again after saving.</p>

    <% if flash[:alert] %><div class="alert" role="alert"><%= flash[:alert] %></div><% end %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "assignment-form auth-form" do |form| %>
      <div class="field">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", minlength: 8, maxlength: 72 %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "Confirm new password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72 %>
      </div>
      <%= form.submit "Save new password", class: "btn btn-primary" %>
    <% end %>

    <p class="status-hint"><%= link_to "Back to staff sign in", new_session_path %></p>
  </section>
</main>
