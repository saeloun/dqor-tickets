<nav class="app-tabbar" aria-label="App navigation">
  <%= link_to tickets_store_path, class: class_names("app-tab", "app-tab--active": current_page?(tickets_store_path)) do %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3a2 2 0 0 0 0 4v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3a2 2 0 0 0 0-4z"/><path d="M13 5v14"/></svg>
    <span>Tickets</span>
  <% end %>
  <%= link_to my_tickets_path, class: class_names("app-tab", "app-tab--active": current_page?(my_tickets_path)) do %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="14" x="3" y="5" rx="2"/><circle cx="8" cy="12" r="2"/><path d="M13 10h5M13 14h3"/></svg>
    <span>My passes</span>
  <% end %>
  <%= link_to find_tickets_path, class: class_names("app-tab", "app-tab--active": current_page?(find_tickets_path)) do %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
    <span>Find</span>
  <% end %>
  <% if user_signed_in? %>
    <%= link_to account_root_path, class: class_names("app-tab", "app-tab--active": current_page?(account_root_path)) do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <span>Account</span>
    <% end %>
  <% else %>
    <%= link_to account_sign_in_path, class: class_names("app-tab", "app-tab--active": current_page?(account_sign_in_path)) do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5M15 12H3"/></svg>
      <span>Log in</span>
    <% end %>
  <% end %>
</nav>
