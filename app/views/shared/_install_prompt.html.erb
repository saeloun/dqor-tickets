<aside class="install-prompt" data-controller="install" hidden>
  <div class="install-prompt__inner">
    <%= image_tag "deccan-logo.png", alt: "", class: "install-prompt__icon", loading: "lazy" %>
    <div class="install-prompt__body">
      <p class="install-prompt__title">Get the app</p>
      <p class="install-prompt__text" data-install-target="text">Your pass and entry QR, one tap away.</p>
    </div>
    <button type="button" class="btn btn-primary install-prompt__install" data-action="install#install" data-install-target="installButton" hidden>Install</button>
    <button type="button" class="install-prompt__dismiss" data-action="install#dismiss" aria-label="Dismiss">&times;</button>
  </div>
</aside>
