<% content_for :title, "Updates · Deccan Queen on Rails" %>
<% content_for :meta_description, "Announcements and news for Deccan Queen on Rails." %>

<main class="schedule-page">
  <section class="page-hero">
    <p class="section-label">Updates</p>
    <h1>Conference updates</h1>
    <p>Announcements and news for Deccan Queen on Rails, Pune.</p>
  </section>

  <% if @announcements.any? %>
    <ul class="update-list">
      <% @announcements.each do |announcement| %>
        <li class="update">
          <p class="update__date"><%= announcement.shown_at.strftime("%-d %B %Y") %></p>
          <h2 class="update__title"><%= announcement.title %></h2>
          <% if announcement.body.present? %><div class="update__body"><%= simple_format(announcement.body) %></div><% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="schedule-empty">No updates yet — check back soon.</p>
  <% end %>
</main>
