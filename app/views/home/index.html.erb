       ================================================================ -->
  <section class="section schedule-section" id="schedule">
    <div class="container">
      <div class="text-center" style="margin-bottom:3rem">
        <span class="section-label">The Full Experience</span>
        <h2 class="section-heading">Four days in Pune</h2>
        <p class="section-subheading" style="margin:0 auto">Talks, community, culture, and the open roads of Maharashtra.</p>
      </div>

      <div class="journey-grid">
        <div class="journey-card card">
          <div class="journey-day-badge">
            <span class="journey-date">Oct 8, Thu</span>
            <span class="journey-day-num">Day 1</span>
          </div>
          <div class="journey-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <h3>Conference Day 1</h3>
          <p>Keynotes and talks from Rails developers who've been building with Rails from day one — and those pushing its future. Full single track.</p>
        </div>

        <div class="journey-card card">
          <div class="journey-day-badge">
            <span class="journey-date">Oct 9, Fri</span>
            <span class="journey-day-num">Day 2</span>
          </div>
          <div class="journey-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Conference Day 2</h3>
          <p>More talks, lightning sessions, hallway conversations — and the afterparty, where the best ideas always happen.</p>
        </div>

        <div class="journey-card card">
          <div class="journey-day-badge">
            <span class="journey-date">Oct 10, Sat</span>
            <span class="badge-pill ruby" style="font-size:.7rem">Rails Girls</span>
          </div>
          <div class="journey-icon" style="background:hsl(348 70% 35% / 0.06)" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <h3>Rails Girls Pune</h3>
          <p>A full-day program for women and non-binary people. Build your first Rails app with coaches from the community.</p>
          <a href="#rails-girls" class="btn btn-ghost">Learn more <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
        </div>

        <div class="journey-card card">
          <div class="journey-day-badge">
            <span class="journey-date">Oct 11, Sun</span>
            <span class="badge-pill gold" style="font-size:.7rem">Explore Pune Day</span>
          </div>
          <div class="journey-icon" style="background:hsl(40 80% 50% / 0.1);color:var(--color-gold)" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l4-8 4 4 4-6 4 10"/><path d="M21 17H3"/></svg>
          </div>
