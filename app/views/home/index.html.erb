  <section class="tickets-section" id="tickets">
    <div class="container">
      <div class="text-center">
        <span class="section-label">Tickets</span>
        <h2 class="section-heading">Choose your experience</h2>
        <p class="section-subheading" style="margin:0 auto">
          Three separate events, three separate tickets. Mix and match what works for you.
        </p>
      </div>

      <div class="tickets-grid">

        <!-- Conference Pass -->
        <div class="ticket-card ticket-card--conference ticket-card--featured">
          <div class="ticket-card-header">
            <span class="ticket-type-badge ticket-type-badge--conference">Conference</span>
            <div class="ticket-card-title">Conference Pass</div>
            <div class="ticket-card-date">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              October 8 &amp; 9, 2026
            </div>
          </div>
          <div class="ticket-card-body">
            <p class="ticket-card-desc">Full access to both conference days — all talks, hallway conversations, and the afterparty.</p>
            <ul class="ticket-includes">
              <li class="ticket-check--conference"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>All talks &amp; keynotes (single track)</li>
              <li class="ticket-check--conference"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>Lunch &amp; chai, both days</li>
              <li class="ticket-check--conference"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>Conference afterparty (Oct 9)</li>
              <li class="ticket-check--conference"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>Explore Pune Day add-on available (Oct 11)</li>
