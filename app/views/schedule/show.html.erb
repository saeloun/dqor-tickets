<% content_for :title, "Schedule · Deccan Queen on Rails" %>
<% content_for :meta_description, "The Deccan Queen on Rails conference schedule — talks, speakers, and timings in Pune." %>

<main class="schedule-page">
  <section class="page-hero">
    <p class="section-label">Schedule</p>
    <h1>Conference schedule</h1>
    <p>Talks and sessions for Deccan Queen on Rails, Pune.</p>
  </section>

  <% if @talks_by_day.any? %>
    <% @talks_by_day.each do |day, talks| %>
      <section class="schedule-day">
        <h2><%= day ? day.strftime("%A, %-d %B %Y") : "To be scheduled" %></h2>
        <ul class="schedule-list">
          <% talks.each do |talk| %>
            <li class="schedule-talk">
              <div class="schedule-talk__time">
                <%= talk.time_range %>
                <% if talk.room.present? %><span class="schedule-talk__room"><%= talk.room %></span><% end %>
              </div>
              <div class="schedule-talk__body">
                <h3><%= talk.title %></h3>
                <% if talk.speaker_display.present? %><p class="schedule-talk__speaker"><%= talk.speaker ? link_to(talk.speaker_display, speaker_path(talk.speaker)) : talk.speaker_display %></p><% end %>
                <% if talk.abstract.present? %><p class="schedule-talk__abstract"><%= talk.abstract %></p><% end %>
                <% if user_signed_in? %>
                  <% if @bookmarked_ids.include?(talk.id) %>
                    <%= button_to "★ Saved", talk_bookmark_path(talk), method: :delete, class: "schedule-talk__save schedule-talk__save--on" %>
                  <% else %>
                    <%= button_to "☆ Save to my schedule", talk_bookmark_path(talk), method: :post, class: "schedule-talk__save" %>
                  <% end %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <p class="schedule-empty">The schedule is being finalised — check back soon. Meanwhile, <%= link_to "grab your pass", tickets_store_path %> or <%= link_to "ask the concierge", concierge_path %>.</p>
  <% end %>
</main>
