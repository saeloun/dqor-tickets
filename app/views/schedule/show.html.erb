<% content_for :title, "Schedule · Deccan Queen on Rails" %>
<% content_for :meta_description, "The Deccan Queen on Rails conference schedule — talks, speakers, and timings in Pune." %>

<main class="schedule-page">
  <section class="page-hero">
    <p class="section-label">Schedule</p>
    <h1>Conference schedule</h1>
    <p>Talks and sessions for Deccan Queen on Rails, Pune.</p>
    <p>Conference afterparty: Thursday, October 8, 2026 (Day 1).</p>
    <%= render "shared/conference_venue" %>
  </section>

  <nav class="schedule-toolbar" aria-label="Schedule actions">
    <%= link_to "Add conference dates to calendar", calendar_path, class: "btn btn-secondary" %>
    <% if user_signed_in? && (current_user.legacy_network_eligible? || !FreeEvents::Access.enabled?) %>
      <%= link_to "My saved schedule", account_root_path(anchor: "my-schedule"), class: "btn btn-secondary" %>
    <% elsif user_signed_in? %>
      <%= link_to "Your free tickets", free_tickets_path, class: "btn btn-secondary" %>
    <% else %>
      <%= link_to "Sign in to save talks", account_sign_in_path, class: "btn btn-secondary" %>
    <% end %>
  </nav>

  <% if Conference.status == :during && (@now_talk || @next_talk) %>
    <section class="schedule-live" aria-label="Now and next">
      <% if @now_talk %>
        <div class="schedule-live__item schedule-live__item--now">
          <span class="schedule-live__label">Happening now</span>
          <strong class="schedule-live__title"><%= @now_talk.title %></strong>
          <span class="schedule-live__meta"><%= @now_talk.time_range %><%= " · #{@now_talk.room}" if @now_talk.room.present? %></span>
        </div>
      <% end %>
      <% if @next_talk %>
        <div class="schedule-live__item">
          <span class="schedule-live__label">Up next</span>
          <strong class="schedule-live__title"><%= @next_talk.title %></strong>
          <span class="schedule-live__meta"><%= @next_talk.time_range %><%= " · #{@next_talk.room}" if @next_talk.room.present? %></span>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @talks_by_day.any? %>
    <% @talks_by_day.each do |day, talks| %>
      <section class="schedule-day">
        <h2><%= day ? day.strftime("%A, %-d %B %Y") : "To be scheduled" %></h2>
        <ul class="schedule-list">
          <% talks.each do |talk| %>
            <li class="schedule-talk <%= "schedule-talk--now" if @now_talk && talk.id == @now_talk.id %>">
              <div class="schedule-talk__time">
                <% if @now_talk && talk.id == @now_talk.id %><span class="schedule-talk__live">● Live now</span><% end %>
                <%= talk.time_range %>
                <% if talk.room.present? %><span class="schedule-talk__room"><%= talk.room %></span><% end %>
              </div>
              <div class="schedule-talk__body">
                <h3><%= link_to talk.title, talk_path(talk) %></h3>
                <% if talk.speaker_display.present? %><p class="schedule-talk__speaker"><%= talk.speaker ? link_to(talk.speaker_display, speaker_path(talk.speaker)) : talk.speaker_display %></p><% end %>
                <% if talk.abstract.present? %><p class="schedule-talk__abstract"><%= talk.abstract %></p><% end %>
                <% if user_signed_in? %>
                  <% if @bookmarked_ids.include?(talk.id) %>
                    <%= button_to "★ Saved", talk_bookmark_path(talk), method: :delete, class: "schedule-talk__save schedule-talk__save--on", data: { turbo_submits_with: "Updating…" }, aria: { label: "Remove #{talk.title} from my schedule" } %>
                  <% else %>
                    <%= button_to "☆ Save to my schedule", talk_bookmark_path(talk), method: :post, class: "schedule-talk__save", data: { turbo_submits_with: "Saving…" }, aria: { label: "Save #{talk.title} to my schedule" } %>
                  <% end %>
                <% end %>
                <%= render "schedule/feedback", talk: talk %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% else %>
    <div class="content-empty">
      <h2>The schedule is being finalised</h2>
      <p>Talks appear here as they're confirmed. The dates are locked — <strong>October 8&ndash;11, 2026</strong> at Hyatt Regency, Pune. Grab your pass now so you're set the moment the line-up drops.</p>
      <div class="content-empty__actions">
        <%= link_to "Get your pass", tickets_store_path, class: "btn btn-primary" %>
        <%= link_to "Ask the concierge", concierge_path, class: "btn btn-secondary" %>
      </div>
    </div>
  <% end %>
</main>
