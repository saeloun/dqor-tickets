<%= render "styles" %>
<main class="community-workspace">
  <%= link_to "← Communities", organizer_organization_groups_path(@organization), class: "back" %><p class="eyebrow">Community workspace</p><h1><%= @group.name %></h1><span class="badge"><%= @group.draft? ? "Draft · private" : "Published · public" %></span>
  <% if @group.errors.any? %><div class="errors" role="alert"><ul><% @group.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <p><%= @group.tagline %></p><p><%= @group.city %> · <%= @group.timezone %></p>
  <% if can_manage_groups? %><div class="actions"><%= link_to "Edit community", edit_organizer_organization_group_path(@organization, @group), class: "button secondary" %><% if @group.draft? %><%= button_to "Publish community", publish_organizer_organization_group_path(@organization, @group), class: "button" %><% else %><%= link_to "View public community", community_group_public_path(@organization.slug, @group.slug), class: "button secondary" %><%= button_to "Make community private", unpublish_organizer_organization_group_path(@organization, @group), class: "button secondary" %><% end %></div><% end %>
  <h2>Events in this community</h2><% @events.each do |event| %><article class="card"><h3><%= link_to event.title, organizer_organization_event_path(@organization, event) %></h3><p><%= event.status.capitalize %></p></article><% end %><% if @events.empty? %><p>No events have been added. Create an event in the organization, then add it here.</p><% end %>
  <% if can_manage_groups? && @available_events.any? %><%= form_with url: add_event_organizer_organization_group_path(@organization, @group), method: :post do |form| %><%= form.label :event_id, "Add an existing organization event" %><%= form.select :event_id, @available_events.map { |event| [ event.title, event.id ] } %><%= form.submit "Add event", class: "button" %><% end %><% end %>
  <p class="muted">Publishing shares this community page. Event pages and registrations keep their current settings.</p>
</main>
