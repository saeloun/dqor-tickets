<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= @event.title %> · Free event</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <%= stylesheet_link_tag "organizer_platform" %>
  </head>
  <body class="attendee-registration">
    <header class="site-header"><nav aria-label="Attendee navigation"><%= link_to (current_user ? "Your free tickets" : "Sign in"), free_tickets_path %></nav></header>
    <% flash.each do |_type, message| %><p class="flash" role="status"><%= message %></p><% end %>
    <%= yield %>
  </body>
</html>
