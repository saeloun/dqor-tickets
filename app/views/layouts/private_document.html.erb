<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="no-referrer">
  <title><%= content_for(:title) || "Private billing · Deccan Queen on Rails" %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <style>
    body{margin:0;background:#f6f3ee;color:#242020;font:16px/1.5 system-ui,sans-serif} header,main{max-width:1000px;margin:auto;padding:24px} header{border-bottom:1px solid #d7cfc8} h1,h2{line-height:1.2} h1{font-size:2rem} a{color:#851932} nav{display:flex;gap:20px;flex-wrap:wrap} .panel{background:white;border:1px solid #d7cfc8;border-radius:10px;padding:24px;margin:20px 0} .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px} label{display:block;font-weight:600;margin-bottom:6px} input:not([type=checkbox]),textarea,select{box-sizing:border-box;width:100%;padding:10px;border:1px solid #877b75;border-radius:4px;font:inherit} textarea{min-height:90px} button,.button{display:inline-block;background:#851932;color:white;padding:10px 18px;border:0;border-radius:5px;font:inherit;cursor:pointer;text-decoration:none} button:disabled{background:#817776;cursor:not-allowed} .muted{color:#665c58}.alert{padding:16px;background:#fff0dc;border-left:4px solid #a85412}.notice{padding:16px;background:#e8f2e5}.status{display:inline-block;padding:3px 10px;border:1px solid #d0c3b9;border-radius:20px;font-weight:600} table{width:100%;border-collapse:collapse} td,th{text-align:left;padding:12px 8px;border-bottom:1px solid #ddd;overflow-wrap:anywhere} .scroll{overflow-x:auto} code{overflow-wrap:anywhere} form{margin:16px 0} .check{display:flex;gap:10px;align-items:start}.check input{margin-top:6px} :focus-visible{outline:3px solid #b57b25;outline-offset:3px}
  </style>
</head>
<body>
<header>
  <strong>Deccan Queen on Rails · Private billing</strong>
  <% if Current.admin_user&.admin? %>
    <nav aria-label="Finance"><%= link_to "Pending documents", finance_documents_path %><%= link_to "Seller policy reviews", finance_policies_path %><%= link_to "Admin", "/avo" %></nav>
  <% end %>
</header>
<main>
  <% if flash[:alert] %><p class="alert" role="alert"><%= flash[:alert] %></p><% end %>
  <% if flash[:notice] %><p class="notice" role="status"><%= flash[:notice] %></p><% end %>
  <%= yield %>
</main>
</body>
</html>
