<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Event organizer</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "organizer_platform" %>
  </head>
  <body>
    <header><strong>Event organizer</strong> <%= link_to "My account", account_root_path %></header>
    <% flash.each do |type, message| %><p class="flash" role="status"><%= message %></p><% end %>
    <%= yield %>
  </body>
</html>
