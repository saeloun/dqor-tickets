<div id="ask-question" class="qa-ask">
  <% if user_signed_in? && current_user.attending? %>
    <%= form_with url: talk_questions_path(talk), class: "qa-ask__form", data: { controller: "chat-composer", action: "turbo:submit-end->chat-composer#afterSubmit" } do |form| %>
      <% if question.errors.any? %>
        <p class="qa-ask__error" role="alert"><%= question.errors.full_messages.to_sentence %></p>
      <% end %>
      <%= text_area_tag "talk_question[body]", question.body, rows: 2, maxlength: 500, placeholder: "Ask the speaker a question…", class: "qa-ask__input", data: { chat_composer_target: "input" } %>
      <%= submit_tag "Ask", class: "btn btn-primary qa-ask__submit" %>
    <% end %>
  <% elsif user_signed_in? %>
    <p class="qa-ask__note">Only attendees with a pass can ask questions. <%= link_to "Get a pass", tickets_store_path %>.</p>
  <% else %>
    <p class="qa-ask__note"><%= link_to "Sign in", account_sign_in_path %> with your ticket email to ask a question.</p>
  <% end %>
</div>
