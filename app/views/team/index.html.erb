  <section class="section speakers-section" id="speakers">
    <div class="container">
      <div class="text-center" style="margin-bottom:3rem">
        <span class="section-label">Team · Deccan Queen on Rails</span>
        <h2 class="section-heading">The crew driving the train</h2>
        <p class="section-subheading" style="margin:0 auto">The team behind Deccan Queen on Rails</p>
      </div>

      <% if @team_members.any? %>
        <div class="speakers-grid">
          <% @team_members.each do |member| %>
          <div class="speaker-card card">
            <%= image_tag member.photo_url, alt: member.name, class: "speaker-card-photo" %>
            <div class="speaker-card-body">
              <p class="speaker-card-name"><%= member.name %></p>
              <p class="speaker-card-role"></p>
            </div>
          </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
