<p style="padding:1rem"><%= link_to "Camera self-test — no admission", scanner_rehearsal_path, data: { turbo: false } %></p>
<p style="padding:1rem"><%= link_to "Change purpose: entry, food or after-party", event_slots_path %></p>
<% content_for :head do %>
  <style>
    .checkin { max-width: 56rem; margin: 0 auto; padding: 1rem; font-family: system-ui, sans-serif; }
    .checkin h1 { margin: .5rem 0 1rem; font-size: 1.75rem; }
    .checkin-controls { display: grid; gap: .75rem; margin-bottom: 1rem; }
    .checkin label { display: grid; gap: .25rem; font-weight: 600; }
    .checkin input, .checkin select, .checkin button { min-height: 2.75rem; padding: .65rem .75rem; border: 1px solid #9ca3af; border-radius: .5rem; font: inherit; }
    .checkin button { cursor: pointer; color: white; background: #991b1b; border-color: #991b1b; font-weight: 700; }
    .checkin-result { margin: 1rem 0; padding: 1rem; border-radius: .5rem; font-weight: 700; }
    .checkin-result--success { color: #14532d; background: #dcfce7; }
    .checkin-result--warning { color: #713f12; background: #fef3c7; }
    .checkin-result--error { color: #7f1d1d; background: #fee2e2; }
    .checkin-results { display: grid; gap: .75rem; margin-top: 1rem; }
    .checkin-ticket { padding: 1rem; border: 1px solid #d1d5db; border-radius: .5rem; background: white; }
    .checkin-ticket p { margin: .25rem 0 .75rem; }
    .checkin button:disabled { opacity: .5; cursor: wait; }
    .checkin :focus-visible { outline: 3px solid #1d4ed8; outline-offset: 3px; }
    .checkin .checkin-select { display: flex; align-items: center; gap: .6rem; }
    .checkin-select input { width: 1.3rem; min-height: 1.3rem; }
    .checkin-batch { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1rem 0; }
    .checkin dialog { max-width: min(36rem, 85vw); max-height: 80vh; overflow-y: auto; border: 1px solid #9ca3af; border-radius: .6rem; }
    .checkin dialog::backdrop { background: #0008; }
    .checkin-outcomes { list-style: none; padding: 0; }
    .checkin-ticket { overflow-wrap: anywhere; }
    #checkin-reader { overflow: hidden; border-radius: .5rem; }
    .checkin-stats { display: flex; flex-wrap: wrap; gap: .6rem; margin: .25rem 0 1.25rem; }
    .checkin-stat { flex: 1 1 7rem; min-width: 6.5rem; padding: .7rem .85rem; border: 1px solid #e5e0d8; border-radius: .6rem; background: #fff; }
    .checkin-stat--primary { background: #991b1b; color: #fff; border-color: #991b1b; }
    .checkin-stat__num { display: block; font-size: 1.55rem; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
    .checkin-stat__of { font-size: .95rem; font-weight: 600; opacity: .6; }
    .checkin-stat__label { display: block; font-size: .76rem; margin-top: .3rem; opacity: .85; }
    @media (min-width: 36rem) { .checkin-controls { grid-template-columns: 10rem 1fr auto; align-items: end; } }
  </style>
<% end %>

<main class="checkin" data-controller="checkin" data-action="turbo:before-cache@document->checkin#beforeCache visibilitychange@document->checkin#visibilityChanged orientationchange@window->checkin#interruptCamera">
  <h1>Attendee check-in</h1>
  <p>Scan tickets one after another, or find and select attendees below. Each check-in is recorded for the selected date. Meal redemption is separate.</p>

  <section class="checkin-stats" aria-label="Check-in progress">
    <div class="checkin-stat checkin-stat--primary">
      <span class="checkin-stat__num" data-checkin-target="count"><%= @stats[:checked_in] %></span>
      <span class="checkin-stat__label">checked in · <%= @date.strftime("%a %b %-d") %></span>
    </div>
    <div class="checkin-stat">
      <span class="checkin-stat__num"><%= @stats[:total] %></span>
      <span class="checkin-stat__label">valid tickets</span>
    </div>
    <% @stats[:by_type].each do |row| %>
      <div class="checkin-stat">
        <span class="checkin-stat__num"><span data-type-count="<%= row[:name] %>"><%= row[:checked_in] %></span><span class="checkin-stat__of">/<%= row[:total] %></span></span>
        <span class="checkin-stat__label"><%= row[:name] %></span>
      </div>
    <% end %>
  </section>

  <form class="checkin-controls" method="get" action="<%= checkin_path %>">
    <label>
      Event date
      <select name="date" data-checkin-target="date control" data-action="change->checkin#changeDate">
        <% CheckinsController::EVENT_DATES.each do |date| %>
          <option value="<%= date.iso8601 %>" <%= "selected" if date == @date %>><%= date.strftime("%b %-d") %></option>
        <% end %>
      </select>
    </label>
    <label>
      Name, email, or order code
      <input data-checkin-target="control" name="q" value="<%= @query %>" autocomplete="off">
    </label>
    <button data-checkin-target="control" type="submit">Search</button>
  </form>

  <p data-checkin-target="cameraStatus" role="status">Tap Request Camera Permissions and choose the back/rear camera. If access is denied, allow camera access in browser settings or use attendee search below.</p>
  <button type="button" data-checkin-target="control" data-action="checkin#restartCamera">Restart camera</button>
  <div id="checkin-reader"></div>
  <div class="checkin-result" data-checkin-target="result" role="status" aria-live="polite" tabindex="-1" hidden></div>

  <section aria-label="Attendee selection">
    <h2>Find and select attendees</h2>
    <p>Showing <%= @tickets.size %> tickets<%= @more_results ? " (more matches exist — refine your search)" : "" %>. Selection applies only to the tickets shown, never other pages. Maximum <%= CheckinsController::MAX_BATCH_SIZE %> per batch.</p>
    <% if @selection_from_admin %><p>These are the tickets selected in the admin dashboard. Review them before confirming.</p><% end %>
    <div class="checkin-batch">
      <button type="button" data-checkin-target="control" data-action="checkin#selectVisible">Select shown tickets</button>
      <button type="button" data-checkin-target="control" data-action="checkin#clearSelection">Clear selection</button>
      <button type="button" data-checkin-target="batchButton" data-action="checkin#reviewBatch" disabled>Review 0 selected tickets</button>
    </div>
    <div class="checkin-results" aria-label="Search results">
      <% @tickets.each do |ticket| %>
        <article class="checkin-ticket">
          <label class="checkin-select">
            <input type="checkbox" value="<%= ticket.id %>" data-checkin-target="selection" data-action="checkin#updateSelection" data-attendee="<%= ticket.attendee_name.presence || ticket.attendee_email %> · <%= ticket.ticket_type.name %> · <%= ticket.order.code %>">
            <strong><%= ticket.attendee_name.presence || "Unnamed attendee" %></strong>
          </label>
          <p><%= ticket.attendee_email %> · <%= ticket.ticket_type.name %> · <%= ticket.order.code %></p>
          <p>Order: <%= ticket.order.status.humanize %><%= " · Canceled ticket" if ticket.canceled_at? %> · <span data-ticket-status="<%= ticket.id %>"><%= ticket.checked_in_at.key?(@date.iso8601) ? "Already checked in on selected date" : "Not checked in on selected date" %></span></p>
          <button type="button" data-checkin-target="control" data-action="checkin#scanTicket" data-ticket-id="<%= ticket.id %>">Check in</button>
        </article>
      <% end %>
      <% if @tickets.empty? %><p>No confirmed attendees match. Check the order status in admin before admitting anyone.</p><% end %>
    </div>
  </section>
  <ol class="checkin-outcomes" data-checkin-target="outcomes" aria-label="Batch results" aria-live="polite"></ol>
  <dialog data-checkin-target="dialog" data-action="cancel->checkin#cancelBatch" aria-labelledby="batch-heading">
    <h2 id="batch-heading">Confirm attendee check-in</h2>
    <div data-checkin-target="confirmation"></div>
    <p>Duplicates and ineligible tickets will not be admitted. Every ticket gets its own result.</p>
    <div class="checkin-batch">
      <button type="button" data-checkin-target="control" data-action="checkin#cancelBatch" autofocus>Cancel</button>
      <button type="button" data-checkin-target="control" data-action="checkin#confirmBatch">Confirm check-in</button>
    </div>
  </dialog>
</main>
