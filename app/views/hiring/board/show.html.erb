<h1><%= @job.title %></h1><p><%= @job.company.name %> · <%= @job.event&.title || "Global" %></p>
<%= simple_format @job.description %>
<section><h2>Apply privately</h2><p>Your submitted snapshot is shared only with this job's recruiter. Changes to your account do not update the snapshot.</p>
<%= form_with url: hiring_apply_path(@job), multipart: true do |f| %>
  <%= fields_for :snapshot do |profile| %>
    <%= profile.label :name, "Your name" %><%= profile.text_field :name, value: current_user.name, required: true %>
    <%= profile.label :summary, "Experience and interest" %><%= profile.text_area :summary, required: true, maxlength: 10000 %>
    <%= profile.label :linkedin, "LinkedIn profile URL (optional)" %><%= profile.url_field :linkedin %>
  <% end %>
  <%= f.label :resume, "Optional PDF resume (maximum 5 MB)" %><%= f.file_field :resume, accept: "application/pdf" %>
  <p>PDFs are quarantined and cannot be downloaded or reviewed. Malware scanning is not configured. Include your relevant experience above.</p>
  <label><%= f.check_box :consent, required: true %> I consent to sharing this snapshot and my account email with this role's recruiter.</label>
  <%= f.submit "Submit application" %>
<% end %></section>
<section><h2>Already work here?</h2><p>Self-reported affiliation grants no employer or admin permissions.</p><%= button_to "Save my company affiliation", hiring_affiliation_path(company_id: @job.company_id) %></section>
