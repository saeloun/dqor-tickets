<h1>Choose whether to share</h1><p>This recruiting request is separate from event entry. Opening it has shared no profile data.</p>
<p>Recipient: <strong><%= @share.recipient.display_name %> (<%= @share.recipient.email %>)</strong></p>
<p>Company: <%= @share.job.company.name %> · Role: <%= @share.job.title %> · <%= @share.job.event&.title || "Global role" %></p>
<p>Access expires at <%= @share.expires_at.utc.iso8601 %>. You can revoke earlier from your applications. A recipient may retain information they already viewed.</p>
<%= form_with url: hiring_recruiting_path(token: params[:token]) do |f| %>
  <%= fields_for :snapshot do |profile| %>
    <%= profile.label :name, "Your name" %><%= profile.text_field :name, value: current_user.name, required: true %>
    <%= profile.label :summary, "Experience to share" %><%= profile.text_area :summary, required: true, maxlength: 10000 %>
    <%= profile.label :linkedin, "LinkedIn profile URL (optional)" %><%= profile.url_field :linkedin %>
  <% end %>
  <p>Your account email <%= current_user.email %> is also included. No resume is shared through this QR flow.</p>
  <label><%= f.check_box :consent, required: true %> I consent to share these details with this named recruiter for this role until the displayed expiry.</label>
  <%= f.submit "Confirm sharing" %>
<% end %>
<%= link_to "Cancel without sharing", hiring_root_path %>
