<% content_for :title, "Tickets · Deccan Queen on Rails" %>

<% available_quantities = @ticket_types.to_h { |ticket_type| [ ticket_type.id, ticket_type.available_quantity ] } %>
<% conference_types = @ticket_types.select(&:conference_pass?) %>
<% conference = conference_types.find { |ticket_type| ticket_type.purchasable? && available_quantities.fetch(ticket_type.id).positive? } || conference_types.first %>
<% rails_girls = @ticket_types.find { |ticket_type| ticket_type.slug == "rails-girls-pune" } %>
<% primary_ticket_types = [ conference, rails_girls ].compact %>
<% remaining_ticket_types = @ticket_types.to_a - primary_ticket_types %>

<main class="storefront">
  <section class="storefront-hero">
    <p class="section-label">Tickets</p>
    <h1>Choose your pass</h1>
    <p>Conference and Rails Girls tickets, plus an optional day out in Pune.</p>
    <%= render "shared/conference_venue" %>
    <p><%= link_to "See the schedule →", schedule_path, class: "storefront-hero__link" %> <span aria-hidden="true">·</span> <%= link_to "Sponsors", sponsors_path, class: "storefront-hero__link" %> <span aria-hidden="true">·</span> <%= link_to "Add to calendar", calendar_path, class: "storefront-hero__link" %></p>
    <% if primary_ticket_types.any? %>
      <nav class="ticket-choices" aria-label="Ticket choices">
        <% if conference %>
          <%= link_to "DQOR tickets", "##{dom_id(conference)}", class: "btn btn-secondary" %>
        <% end %>
        <% if rails_girls %>
          <%= link_to "Rails Girls tickets", "##{dom_id(rails_girls)}", class: "btn btn-secondary" %>
        <% end %>
      </nav>
    <% end %>
    <%= render "shared/whos_coming" %>
    <% if @referrer %>
      <p class="referral-banner"><strong><%= @referrer.display_name %></strong> invited you — <strong>5% off</strong> applied with code <code>FRIENDS</code>.</p>
    <% end %>
  </section>

  <% if flash[:alert] %>
    <p class="alert" role="alert"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: orders_path, scope: :checkout, class: "checkout-form", data: { turbo: false, controller: "cart", cart_preview_url_value: checkout_preview_path } do |form| %>
    <section aria-labelledby="tickets-heading">
      <h2 id="tickets-heading" class="sr-only">Available tickets</h2>

      <% if primary_ticket_types.any? %>
        <div class="tickets-grid tickets-grid--primary">
          <% primary_ticket_types.each do |ticket_type| %>
            <%= render "tickets/ticket_card", ticket_type:, available: available_quantities.fetch(ticket_type.id) %>
          <% end %>
        </div>
      <% end %>

      <% if remaining_ticket_types.any? %>
        <div class="tickets-grid">
          <% remaining_ticket_types.each do |ticket_type| %>
            <%= render "tickets/ticket_card", ticket_type:, available: available_quantities.fetch(ticket_type.id) %>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="order-panel" aria-labelledby="buyer-heading">
      <div class="order-panel__heading">
        <div>
          <p class="section-label">Checkout</p>
          <h2 id="buyer-heading">Your order</h2>
        </div>
        <p>Assign attendees after payment.</p>
      </div>

      <div class="field-grid">
        <div class="field">
          <%= form.label :buyer_name, "Buyer name" %>
          <%= form.text_field :buyer_name, required: true, autocomplete: "name", placeholder: "Your full name" %>
        </div>
        <div class="field">
          <%= form.label :email, "Email" %>
          <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "you@example.com" %>
        </div>
        <div class="field">
          <%= form.label :buyer_phone, "Phone" %>
          <%= form.telephone_field :buyer_phone, autocomplete: "tel", placeholder: "+91 98765 43210" %>
        </div>
        <div class="field">
          <%= form.label :coupon_code, "Coupon code" %>
          <%= form.text_field :coupon_code, value: @prefill_coupon, autocomplete: "off", placeholder: "Optional", data: { cart_target: "coupon", action: "input->cart#couponChanged" } %>
          <p class="coupon-message" data-cart-target="discount" role="status" aria-live="polite" hidden></p>
        </div>
      </div>

      <details class="gst-details" data-cart-target="billingDetails" <%= "open" if params[:checkout].present? %>>
        <summary>Buying for a company? Add GST details</summary>
        <p class="gst-hint">Required for GST-registered buyers and orders of ₹50,000 or more. For smaller personal bookings, leave these blank unless you want billing details on the invoice. Billing details stay private.</p>
        <div class="field-grid">
          <div class="field">
            <%= form.label :gst_legal_name, "Registered company name" %>
            <%= form.text_field :gst_legal_name, value: params.dig(:checkout, :gst_legal_name), data: { cart_target: "legalName" }, autocomplete: "organization", placeholder: "Saeloun India Pvt Ltd" %>
          </div>
          <div class="field">
            <%= form.label :gstin, "GSTIN" %>
            <%= form.text_field :gstin, value: params.dig(:checkout, :gstin), data: { cart_target: "gstin", action: "input->cart#updateBilling" }, maxlength: 15, autocomplete: "off", placeholder: "27AAAAA0000A1Z5" %>
          </div>
          <div class="field">
            <%= form.label :billing_state_code, "State code" %>
            <%= form.text_field :billing_state_code, value: params.dig(:checkout, :billing_state_code), data: { cart_target: "billingField" }, maxlength: 2, inputmode: "numeric", autocomplete: "off", placeholder: "27" %>
          </div>
          <div class="field">
            <%= form.label :billing_address, "Billing address" %>
            <%= form.text_area :billing_address, value: params.dig(:checkout, :billing_address), maxlength: 1000, autocomplete: "street-address", data: { cart_target: "billingField", action: "input->cart#updateBilling" } %>
          </div>
          <div class="field">
            <%= form.label :billing_state_name, "State or union territory name" %>
            <%= form.text_field :billing_state_name, value: params.dig(:checkout, :billing_state_name), maxlength: 100, autocomplete: "address-level1", data: { cart_target: "billingField", action: "input->cart#updateBilling" } %>
          </div>
          <div class="field">
            <%= form.label :delivery_address, "Delivery address, if different (optional)" %>
            <%= form.text_area :delivery_address, value: params.dig(:checkout, :delivery_address), maxlength: 1000, autocomplete: "off" %>
          </div>
        </div>
        <label><%= form.check_box :billing_details_requested, data: { cart_target: "billingRequested", action: "change->cart#updateBilling" } %> Include my billing details on the invoice</label>
        <p data-cart-target="billingNotice" role="status"></p>
      </details>

      <section class="add-on-gate" data-cart-target="addOnGate" hidden aria-labelledby="conference-heading">
        <h3 id="conference-heading">Already have a conference pass?</h3>
        <p>For a standalone Explore Pune Day add-on, enter the paid order details from your confirmation email.</p>
        <div class="field-grid">
          <div class="field">
            <%= form.label :conference_order_code, "Paid order code" %>
            <%= form.text_field :conference_order_code, maxlength: 8, autocomplete: "off" %>
          </div>
          <div class="field">
            <%= form.label :conference_order_email, "Paid order email" %>
            <%= form.email_field :conference_order_email, autocomplete: "email" %>
          </div>
        </div>
      </section>

      <%= form.button class: "btn btn-primary order-cta", type: "submit" do %>
        Continue to payment <span aria-hidden="true">·</span> <span data-cart-target="total"><%= inr(0) %></span>
      <% end %>
    </section>
  <% end %>

  <p class="find-tickets-prompt">
    Already booked? <%= link_to "Email me my tickets", find_tickets_path %>
  </p>
</main>
