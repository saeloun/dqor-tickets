<% state = ticket_sale_state(ticket_type, available: available) %>
<% add_on = ticket_type.requires_conference_pass? %>
<% rails_girls = ticket_type.slug == "rails-girls-pune" %>
<% featured = ticket_type.slug == "conference-pass-regular" %>
<% supporter = ticket_type.slug == "supporter-pass" %>
<% includes = if add_on
     [ "Guided tour around Pune", "Local food trail", "Transport included", "Limited to 50 guests" ]
   elsif rails_girls
     [ "Build a Rails app with coaches", "No Rails experience required", "Bring a laptop", "Lunch and snacks included" ]
   elsif supporter
     [ "All talks and keynotes", "Lunch and chai on both days", "Conference afterparty (Oct 8)", "Your name listed as a supporter on deccanqueenonrails.com", "Explore Pune Day add-on available" ]
   else
     [ "All talks and keynotes", "Lunch and chai on both days", "Conference afterparty (Oct 8)", "Explore Pune Day add-on available" ]
   end %>

<article id="<%= dom_id(ticket_type) %>" tabindex="-1" class="ticket-card <%= add_on ? "ticket-card--retreat" : rails_girls ? "ticket-card--rails-girls" : "ticket-card--conference" %> <%= "ticket-card--featured" if featured %> ticket-card--<%= state.parameterize %>">
  <div class="ticket-card-header">
    <div class="ticket-card-badges">
      <span class="ticket-type-badge <%= add_on ? "ticket-type-badge--retreat" : rails_girls ? "ticket-type-badge--rails-girls" : "ticket-type-badge--conference" %>"><%= add_on ? "Explore Pune Day" : rails_girls ? "Rails Girls Pune" : "Conference" %></span>
      <span class="ticket-state-badge"><%= state %></span>
    </div>
    <h2 class="ticket-card-title"><%= ticket_type.name %></h2>
    <div class="ticket-card-date">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
      <%= add_on ? "October 11, 2026 (Sunday)" : rails_girls ? "October 10, 2026 (Saturday)" : "October 8 & 9, 2026" %>
    </div>
  </div>

  <div class="ticket-card-body">
    <p class="ticket-card-desc"><%= ticket_type.description %></p>
    <ul class="ticket-includes">
      <% includes.each do |item| %>
        <li class="<%= add_on ? "ticket-check--retreat" : rails_girls ? "ticket-check--rails-girls" : "ticket-check--conference" %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <%= item %>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="ticket-card-footer">
    <div class="ticket-price">
      <% if state == "on sale" %>
        <span class="ticket-price-amount"><%= inr(ticket_type.price_paise) %></span>
        <span class="ticket-price-note">GST included</span>
      <% else %>
        <span class="ticket-price-amount"><%= state %></span>
      <% end %>
      <% if ticket_type.capacity %>
        <span class="<%= class_names("ticket-availability", "ticket-availability--low": available <= 10) %>"><%= available %> of <%= ticket_type.capacity %> left</span>
      <% end %>
    </div>

    <% if add_on %>
      <%= check_box_tag "checkout[quantities][#{ticket_type.id}]", 1, false,
            id: "checkout_quantities_#{ticket_type.id}", disabled: state != "on sale",
            class: "add-on-checkbox__input",
            data: { cart_target: "quantity", ticket_type_id: ticket_type.id, ticket_kind: "add-on", unit_price: ticket_type.price_paise, action: "cart#sync" } %>
      <%= label_tag "checkout_quantities_#{ticket_type.id}", class: "add-on-checkbox" do %>
        <span class="add-on-checkbox__mark" aria-hidden="true">✓</span>
        <span>Add Explore Pune Day</span>
      <% end %>
    <% elsif state == "on sale" %>
      <div class="quantity-stepper" data-ticket-control>
        <button type="button" data-action="cart#decrement" data-ticket-type-id="<%= ticket_type.id %>" aria-label="Remove one <%= ticket_type.name %>">−</button>
        <%= number_field_tag "checkout[quantities][#{ticket_type.id}]", 0,
              id: "checkout_quantities_#{ticket_type.id}", min: 0, max: [ticket_type.max_per_order, (available if ticket_type.capacity)].compact.min,
              data: { cart_target: "quantity", ticket_type_id: ticket_type.id, ticket_kind: rails_girls ? "standalone" : "conference", unit_price: ticket_type.price_paise, action: "change->cart#sync input->cart#sync" },
              aria: { label: "#{ticket_type.name} quantity" } %>
        <button type="button" data-action="cart#increment" data-ticket-type-id="<%= ticket_type.id %>" aria-label="Add one <%= ticket_type.name %>">+</button>
      </div>
    <% else %>
      <p class="ticket-unavailable"><%= { "sold out" => "This tier has sold out.", "sales closed" => "Sales for this tier have closed." }.fetch(state, "Sales open soon.") %></p>
    <% end %>
  </div>
</article>
