+      # Revoke while holding the same lock as broadcast/heartbeat writers.
+      # shutdown wakes the receive owner; only that owner closes the fd.
+      def revoke(reconnect)
+        @wlock.synchronize do
+          unless @closed
+            Driver.send_frame(@fd, Tep::WebSocket::OPCODE_TEXT,
+              "{\"type\":\"disconnect\",\"reason\":\"remote\",\"reconnect\":" + reconnect.to_s + "}")
+            Driver.send_frame(@fd, Tep::WebSocket::OPCODE_CLOSE,
+              Driver.encode_close_payload(Tep::WebSocket::CLOSE_POLICY_VIOLATION, "authorization revoked"))
+            @closed = true
+            Sock.shutdown(@fd, 2)
+          end
+        end
+        0
+      end
+
+      def retired?
+        closed = false
+        @wlock.synchronize { closed = @closed }
+        closed
+      end
+
