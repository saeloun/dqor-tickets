+  # Snapshot drivers, not fd numbers, and never hold the registry across IO.
+  def self.disconnect_user(user_id, reconnect)
+    selected = [Tep::WebSocket::Driver.new(-1)]
+    selected.pop
+    Tep::APP.cable_conns_lock.synchronize do
+      Tep::APP.cable_conns.each do |ws|
+        selected << ws if ws.cable_user_id == user_id
+      end
+    end
+    selected.each { |ws| ws.revoke(reconnect) }
+    selected.length
+  end
